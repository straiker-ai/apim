# Copy to .env and fill in. .env is gitignored.

# APIM gateway hosting the Straiker policy fragments
APIM_BASE=https://your-apim-instance.azure-api.net
APIM_PATH=/protected-agentic/v1/chat/completions
APIM_SUB_KEY=your-apim-subscription-key

# Provider key (Azure OpenAI, OpenAI, etc.). Forwarded by APIM as Authorization
# Bearer to the upstream model endpoint. Never seen by Straiker.
OPENAI_API_KEY=sk-proj-...

# Optional knobs
AGENT_MODEL=gpt-4o-mini
AGENT_USER_NAME=azure-aigw-user-agentic
AGENT_MAX_ITERATIONS=6
AGENT_HTTP_TIMEOUT=60
